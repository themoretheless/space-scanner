{
  "languages": {
    "Rust": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "allTargets": true
        },
        "check": {
          "command": "check",
          "workspace": true
        },
        "rust": {
          "analyzerTargetDir": true
        }
      }
    }
  }
}
